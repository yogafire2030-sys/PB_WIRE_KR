# 복사해서 .env 로 저장 후 사용 (.env 는 절대 공유·업로드 금지)
HOST=127.0.0.1
PORT=5000

# 번역: auto | deepl | azure | papago | edge | google | bing | mymemory
TRANSLATOR=auto
DEEPL_API_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=
MYMEMORY_EMAIL=

POLL_INTERVAL=10
MARKET_POLL_INTERVAL=15
